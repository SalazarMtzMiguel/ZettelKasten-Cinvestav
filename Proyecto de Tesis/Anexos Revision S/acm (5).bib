author = {Cruz, Lu\'{\i}s and Fernandes, Jo\~{a}o Paulo and Kirkeby, Maja H. and Mart\'{\i}nez-Fern\'{a}ndez, Silverio and Sallou, June and Anwar, Hina and Barba Roque, Enrique and Bogner, Justus and Casta\~{n}o, Joel and Castor, Fernando and Chasmawala, Aadil and Cunha, Sim\~{a}o and Feitosa, Daniel and Gonz\'{a}lez, Alexandra and Jedlitschka, Andreas and Lago, Patricia and Muccini, Henry and Oprescu, Ana and Rani, Pooja and Saraiva, Jo\~{a}o and Sarro, Federica and Selvan, Raghavendra and Vaidhyanathan, Karthik and Verdecchia, Roberto and Yamshchikov, Ivan P.},
