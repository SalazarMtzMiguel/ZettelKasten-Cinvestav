@inproceedings{10.5555/3511065.3511077,
author = {Washizaki, Hironori and Khomh, Foutse and Gu\'{e}h\'{e}neuc, Yann-Ga\"{e}l and Takeuchi, Hironori and Okuda, Satoshi and Natori, Naotake and Shioura, Naohisa},
