@inproceedings{10.5555/3432601.3432645,
author = {Enenkel, Robert F. and M\"{u}ller, Silvia M. and Anand, Christopher K.},
title = {Novel hardware &amp; software design for mathematical and AI acceleration},
year = {2020},
publisher = {IBM Corp.},
