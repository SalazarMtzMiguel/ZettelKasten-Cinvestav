@inproceedings{10.1145/3449726.3462740,
author = {Nikitin, Nikolay O. and Hvatov, Alexander and Polonskaia, Iana S. and Kalyuzhnaya, Anna V. and Grigorev, Georgii V. and Wang, Xiaohao and Qian, Xiang},
