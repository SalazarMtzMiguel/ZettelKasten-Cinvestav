@inproceedings{10.1145/3711129.3711339,
author = {Tang, Siyu and Tong, Chengchang and Chen, Xiangyu and Yue, Jiajia and Wang, Hongbo},
title = {Research on an Autonomous Underwater Vehicle Intelligent Path Planning Algorithm Based on Improved Artificial Potential Field Method Optimization},
year = {2025},
isbn = {9798400710094},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3711129.3711339},
doi = {10.1145/3711129.3711339},
abstract = {Autonomous Underwater Vehicles (AUVs) encounter various challenges, such as navigation and obstacle avoidance, in complex underwater environments. This paper presents an intelligent path planning algorithm for AUVs that integrates the Artificial Potential Field (APF) method with the Particle Swarm Optimization (PSO) algorithm. Initially, two significant enhancements to the traditional APF method are introduced: a tangential force derived from existing virtual forces, and a correction factor for the repulsive force function that considers the distance to the target. Furthermore, to tackle the issue of multi-parameter tuning in the improved algorithm, the PSO algorithm is utilized to optimize these parameters. Simulation experiments demonstrate that the proposed AUV path planning algorithm, grounded in the enhanced APF method, effectively improves the algorithm's ability to escape force equilibrium, addresses unreachable target points, and optimizes parameter selection and path planning across various static obstacle environments.},
booktitle = {Proceedings of the 2024 8th International Conference on Electronic Information Technology and Computer Engineering},
pages = {1241–1247},
numpages = {7},
keywords = {Artificial Potential Field, Autonomous Underwater Vehicle, Particle Swarm Optimization},
location = {
},
series = {EITCE '24}
}

@inproceedings{10.1145/3677333.3678268,
author = {Ryu, Jimin and Yoon, Yong Ik},
title = {Designing Middleware for Ethical Decision-Making(EDM) in Autonomous Driving: Bias Detection Algorithms(BDA) for Enhanced Pedestrian Situation Awareness},
year = {2024},
isbn = {9798400718021},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3677333.3678268},
doi = {10.1145/3677333.3678268},
abstract = {As autonomous driving technology develops, the importance of system safety and ethical decision-making is increasingly emphasized. In this paper, we propose a new scheduling framework for Bias Detection Algorithm(BDA) designed to improve pedestrian situation awareness in autonomous vehicles. The focus is on developing algorithms that eliminate prejudice against various pedestrians and ensure fairness and responsiveness in awareness. By analyzing scenarios and designing target algorithms, we aim for a fair and safe system by improving response to unpredictable situations. Leveraging parallel processing and distributed computing, this framework ensures timely and fair decisions in complex urban environments. It is emphasized that the capabilities of the proposed algorithm should be applied in various pedestrian scenarios to significantly improve safety and system efficiency.},
booktitle = {Workshop Proceedings of the 53rd International Conference on Parallel Processing},
pages = {106–107},
numpages = {2},
keywords = {Autonomous Driving, Bias-Detection Algorithm, Ethical Decision-Making, Middleware, Pedestrian, Scheduler, Situation Awareness},
location = {Gotland, Sweden},
series = {ICPP Workshops '24}
}

