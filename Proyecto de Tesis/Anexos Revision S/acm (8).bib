publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3491003.3493330},
doi = {10.1145/3491003.3493330},
abstract = {In this tutorial, the aim is to report some basic results about computational models representing robot based computing systems. In particular, we consider what in the literature is referred to as the model. This is one of the most investigated theoretical models that concerns the minimization of the requirements/capabilities of the involved robots to accomplish a given task in a distributed way. The tutorial is divided into two parts. The first one is more introductive and concerns the specification of the model along with its possible variants. The second part is instead devoted to one of the main basic problems investigated in the literature within robot based computing systems: the Pattern Formation. We describe the known main achievements and introduce challenging research directions.},
booktitle = {Proceedings of the 23rd International Conference on Distributed Computing and Networking},
pages = {221–224},
numpages = {4},
